@using Microsoft.AspNetCore.Http
@using WolflineSquadTTT.Services
@inject IHttpContextAccessor HttpContextAccessor
@inject ISteamService SteamService
@RenderSection("Styles", required: false)
@{
    Dictionary<ulong, string> workshopImages = await SteamService.GetWorkshopPreviewImagesAsync(new List<ulong> 
    {
        (ulong)ESteamWorkshopIds.WutheringWavesPlayerModels,
        (ulong)ESteamWorkshopIds.MainCollection,
        (ulong)ESteamWorkshopIds.Maps
    });
    string baseWorkshopLink = $"https://steamcommunity.com/sharedfiles/filedetails/?id=";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WolflineSquadTTT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WolflineSquadTTT.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WolflineSquadTTT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="ServerRules">Rules</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Polls" asp-action="Index">Polls</a>
                        </li>
                        @if (HttpContextAccessor.HttpContext?.Session.GetString("SteamID") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="PointShop" asp-action="Inventory">Inventory</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Market" asp-action="Index">Market</a>
                            </li>
                        }
                        @if (PermissionHelper.HasPermission(HttpContextAccessor.HttpContext!.Session, Permission.ManageRights))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Administration" asp-action="PermissionManagement">Permissions</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#steamWorkshopModal">Workshop Items</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link external" target="_blank" rel="noopener noreferrer" href="https://wolflinesquad.tebex.io/">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link external" target="_blank" rel="noopener noreferrer" href="https://discord.gg/zmJcK2Bkza">Discord</a>
                        </li>
                    </ul>
                    <div class="ms-auto">
                        @if (HttpContextAccessor?.HttpContext?.Session.GetString("SteamID") == null)
                        {
                            <a href="/auth/steam" class="steam-login-button">
                                <img src="/images/steam/sits_01.png" alt="Login with Steam" height="32">
                            </a>
                        }
                        else
                        {
                            <a href="/auth/logout" class="btn btn-outline-danger btn-sm ms-2">
                                Log out
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="modal fade" id="steamWorkshopModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark text-light">

                <div class="modal-header">
                    <h5 class="modal-title">Steam Workshop Collection</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3" id="workshopTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active"
                                    id="miscellaneous-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#miscellaneous"
                                    type="button"
                                    role="tab"
                                    aria-controls="miscellaneous"
                                    aria-selected="true">
                                Miscellaneous
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="playermodels-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#playermodels"
                                    type="button"
                                    role="tab"
                                    aria-controls="playermodels"
                                    aria-selected="false">
                                Playermodels
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link"
                                    id="maps-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#maps"
                                    type="button"
                                    role="tab"
                                    aria-controls="maps"
                                    aria-selected="false">
                                Maps
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="miscellaneous" role="tabpanel" aria-labelledby="miscellaneous-tab">
                            <div style="display:flex; flex-wrap:wrap; gap:20px; justify-content:center;">
                                <div style="text-align:center;">
                                    <a href="@($"{baseWorkshopLink}{(ulong)ESteamWorkshopIds.MainCollection}")" target="_blank">
                                        <img src="@workshopImages[(ulong)ESteamWorkshopIds.MainCollection]"
                                             class="img-fluid rounded shadow"
                                             style="cursor:pointer; max-height:30vh;" />
                                    </a>
                                    <div style="margin-top:5px; font-size:0.9rem;">Main Collection</div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="playermodels" role="tabpanel" aria-labelledby="playermodels-tab">
                            <div style="display:flex; flex-wrap:wrap; gap:20px; justify-content:center;">
                                <div style="text-align:center">
                                    <a href="@($"{baseWorkshopLink}{(ulong)ESteamWorkshopIds.WutheringWavesPlayerModels}")" target="_blank">
                                        <img src="@workshopImages[(ulong)ESteamWorkshopIds.WutheringWavesPlayerModels]"
                                                class="img-fluid rounded shadow"
                                                style="cursor:pointer; max-height:30vh" />
                                    </a>
                                    <div style="margin-top:5px; font-size:0.9rem;">Wuthering Waves Playermodels</div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="maps" role="tabpanel" aria-labelledby="maps-tab">
                            <div style="display:flex; flex-wrap:wrap; gap:20px; justify-content:center;">
                                <div style="text-align:center">
                                    <a href="@($"{baseWorkshopLink}{(ulong)ESteamWorkshopIds.Maps}")" target="_blank">
                                        <img src="@workshopImages[(ulong)ESteamWorkshopIds.Maps]"
                                             class="img-fluid rounded shadow"
                                             style="cursor:pointer; max-height:30vh" />
                                    </a>
                                    <div style="margin-top:5px; font-size:0.9rem;">TTT Maps</div>
                                </div>
                            </div>
                        </div>

                    </div>                    
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between">
            <div>
                &copy; 2026 - WolflineSquadTTT - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> - <a asp-area="" asp-controller="Home" asp-action="Gdpr">GDPR</a>
            </div>
            @if (HttpContextAccessor?.HttpContext?.Session.GetString("SteamID") != null)
            {
                <div>SteamID: @HttpContextAccessor.HttpContext.Session.GetString("SteamID")</div>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
