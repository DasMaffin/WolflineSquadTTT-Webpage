@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Something went wrong";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong - WolflineSquadTTT</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background-color: #16181c;
            color: #e8e8ea;
            font-family: system-ui, "Segoe UI", Roboto, sans-serif;
        }

        .err-card {
            max-width: 640px;
            width: 100%;
            text-align: center;
            background-color: rgba(20, 22, 28, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 36px 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .err-card h1 { font-size: 1.6rem; margin: 0 0 16px; }
        .err-card h1 span { color: #d63384; }
        .err-card > p { color: #9aa0aa; line-height: 1.6; margin: 0 0 10px; }

        .err-msg {
            color: #f3b6c8;
            font-size: 1rem;
            line-height: 1.5;
            background-color: rgba(214, 51, 132, 0.12);
            border: 1px solid rgba(214, 51, 132, 0.35);
            border-radius: 8px;
            padding: 12px 14px;
            margin: 0 0 8px;
            word-break: break-word;
        }

        .err-type { color: #5f636b; font-size: 0.8rem; margin: 0; }

        .err-btn {
            display: inline-block;
            margin-top: 18px;
            padding: 10px 22px;
            border: 0;
            border-radius: 8px;
            background-color: #d63384;
            color: #fff;
            font-weight: 600;
            cursor: pointer;
        }

        .err-details { margin-top: 18px; text-align: left; }
        .err-details summary { cursor: pointer; color: #9aa0aa; font-size: 0.85rem; }
        .err-details pre {
            margin-top: 8px;
            max-height: 320px;
            overflow: auto;
            background-color: #0f1115;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 12px;
            font-size: 0.75rem;
            color: #c7ccd4;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .err-rid { margin-top: 20px; font-size: 0.75rem; color: #5f636b; }
    </style>
</head>
<body>
    <div class="err-card">
        <h1>Something went wrong<span>.</span></h1>

        @if (!string.IsNullOrEmpty(Model?.Message))
        {
            <p class="err-msg">@Model.Message</p>
            <p class="err-type">@Model.ExceptionType@(string.IsNullOrEmpty(Model.Path) ? "" : " · " + Model.Path)</p>
        }
        else
        {
            <p>WolflineSquad ran into an unexpected problem. Please try again in a few moments.</p>
        }

        <button type="button" class="err-btn" onclick="location.reload()">Try again</button>

        @if (!string.IsNullOrEmpty(Model?.StackTrace))
        {
            <details class="err-details">
                <summary>Technical details</summary>
                <pre>@Model.StackTrace</pre>
            </details>
        }

        @if (Model?.ShowRequestId ?? false)
        {
            <div class="err-rid">Reference: <code>@Model!.RequestId</code></div>
        }
    </div>
</body>
</html>
