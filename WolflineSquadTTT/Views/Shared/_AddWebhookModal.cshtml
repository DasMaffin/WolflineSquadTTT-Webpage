@model AddWebhookModalViewModel
@using WolflineSquadTTT.Models.Enums

@{
    // One modal per page is enough — both call sites render this partial at most once.
    string label = WebhookIndexViewModel.EventLabel(Model.Event);
}

<button type="button" class="@Model.ButtonClass" data-bs-toggle="modal" data-bs-target="#addWebhookModal">
    @Model.ButtonText
</button>

<div class="modal fade" id="addWebhookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Add webhook</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Webhooks" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventType" value="@Model.Event" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="modal-body">
                    <p class="text-muted">
                        Posts a Discord-compatible message to a URL when this happens:
                        <strong>@label</strong>.
                    </p>

                    <label class="form-label" for="whName">Name (optional)</label>
                    <input type="text" class="form-control" id="whName" name="name" maxlength="100" placeholder="e.g. Discord #market" />

                    <label class="form-label mt-2" for="whUrl">Webhook URL</label>
                    <input type="url" class="form-control" id="whUrl" name="url" maxlength="500"
                           placeholder="https://discord.com/api/webhooks/…" required />

                    <label class="form-label mt-2" for="whFormat">Application</label>
                    <select class="form-select" id="whFormat" name="format">
                        @foreach (WebhookFormat fmt in Enum.GetValues<WebhookFormat>())
                        {
                            if (fmt == WebhookFormat.Discord)
                            {
                                <option value="@fmt" selected>@WebhookIndexViewModel.FormatLabel(fmt)</option>
                            }
                            else
                            {
                                <option value="@fmt">@WebhookIndexViewModel.FormatLabel(fmt)</option>
                            }
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-link me-auto" asp-controller="Webhooks" asp-action="Index">Manage all webhooks</a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add webhook</button>
                </div>
            </form>
        </div>
    </div>
</div>
