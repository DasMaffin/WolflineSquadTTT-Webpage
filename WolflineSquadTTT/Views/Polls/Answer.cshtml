@model PollAnswerViewModel
@{
    Poll poll = Model.Poll;
    ViewData["Title"] = poll.Title;
}

<style>
    .poll-answer-wrap {
        max-width: 600px;
        margin-inline: auto;
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .poll-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 1rem;
    }

    /* Shared choice row (radio + checkbox) */
    .poll-option {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        margin: 0;
        padding: 14px 18px;
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease;
    }

    .poll-option:hover {
        background-color: rgba(255, 255, 255, .05);
    }

    .poll-option:has(.poll-choice-input:checked) {
        border-color: var(--bs-primary);
        background-color: rgba(13, 110, 253, .08);
    }

    .poll-option:has(.poll-choice-input:disabled) {
        opacity: .55;
        cursor: not-allowed;
    }

    /* Visually hidden but still focusable for keyboard + native validation. */
    .poll-choice-input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
        margin: 0;
    }

    .poll-choice-box {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--bs-border-color);
        border-radius: 9px;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1;
        color: var(--bs-primary);
    }

    .poll-choice-input:checked + .poll-choice-box {
        border-color: var(--bs-primary);
    }

    .poll-choice-input:checked + .poll-choice-box::after {
        content: "\2715"; /* ✕ */
    }

    .poll-choice-input:focus-visible + .poll-choice-box {
        outline: 2px solid var(--bs-primary);
        outline-offset: 2px;
    }

    .poll-option-text {
        font-size: 1.05rem;
    }

    /* Ranking */
    .poll-rank-list {
        list-style: none;
        padding: 0;
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .rank-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border: 1px solid var(--bs-border-color);
        border-radius: 12px;
        background-color: var(--bs-body-bg);
        user-select: none;
    }

    .rank-item.dragging {
        position: relative;
        z-index: 10;
        border-color: var(--bs-primary);
        box-shadow: 0 8px 18px rgba(0, 0, 0, .45);
    }

    .rank-handle {
        flex: 0 0 auto;
        font-size: 1.4rem;
        line-height: 1;
        color: var(--bs-secondary-color);
        cursor: grab;
        touch-action: none;
    }

    .rank-item.dragging .rank-handle {
        cursor: grabbing;
    }

    .rank-number {
        flex: 0 0 auto;
        width: 1.8rem;
        text-align: center;
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--bs-primary);
    }
</style>

<div class="poll-answer-wrap">
    <div class="poll-panel">
    <h1 class="text-center">@poll.Title</h1>
    <p class="text-center text-muted">@poll.Description</p>

    @if (poll.Reward != null)
    {
        <div class="accordion mb-3" id="rewardAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#rewardDetails" aria-expanded="false" aria-controls="rewardDetails">
                        Answer this poll to earn:&nbsp;<strong>@poll.Reward.Name</strong>
                    </button>
                </h2>
                <div id="rewardDetails" class="accordion-collapse collapse" data-bs-parent="#rewardAccordion">
                    <div class="accordion-body">
                        <div class="fw-bold mb-1">This reward contains:</div>
                        <ul class="list-unstyled mb-0">
                            @if (poll.Reward.NormalPoints > 0)
                            {
                                <li>@poll.Reward.NormalPoints normal points</li>
                            }
                            @if (poll.Reward.PremiumPoints > 0)
                            {
                                <li>@poll.Reward.PremiumPoints premium points</li>
                            }
                            @if (poll.Reward.NormalPoints <= 0 && poll.Reward.PremiumPoints <= 0)
                            {
                                <li>No points</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Answer" asp-route-id="@poll.ID" method="post" id="answerForm">
        @switch (poll.Kind)
        {
            case PollType.Basic:
                <div class="poll-options">
                    @foreach (PollOption option in poll.Options)
                    {
                        <label class="poll-option">
                            <input class="poll-choice-input" type="radio" name="optionIds" value="@option.Id" required />
                            <span class="poll-choice-box"></span>
                            <span class="poll-option-text">@option.OptionDescription</span>
                        </label>
                    }
                </div>
                break;

            case PollType.MultiSelect:
                MultiSelectPoll multi = (MultiSelectPoll)poll;
                if (multi.MaxSelections.HasValue)
                {
                    <p class="text-center text-muted">Choose up to @multi.MaxSelections.Value option(s).</p>
                }
                <div class="poll-options">
                    @foreach (PollOption option in poll.Options)
                    {
                        <label class="poll-option">
                            <input class="poll-choice-input poll-check" type="checkbox" name="optionIds" value="@option.Id" />
                            <span class="poll-choice-box"></span>
                            <span class="poll-option-text">@option.OptionDescription</span>
                        </label>
                    }
                </div>
                break;

            case PollType.Ranking:
                List<PollOption> rankOptions = poll.Options.ToList();
                <p class="text-center text-muted">Drag by the handle to order — top is what you like most, bottom is what you like least.</p>
                <ul id="rankList" class="poll-rank-list">
                    @for (int i = 0; i < rankOptions.Count; i++)
                    {
                        <li class="rank-item" data-id="@rankOptions[i].Id">
                            <span class="rank-handle" aria-hidden="true">&#9776;</span>
                            <span class="rank-number">@(i + 1)</span>
                            <span class="poll-option-text">@rankOptions[i].OptionDescription</span>
                        </li>
                    }
                </ul>
                break;
        }

        <div class="text-center">
            <button type="submit" class="btn btn-primary mt-3">Submit</button>
        </div>
    </form>
    </div>
</div>

<script>
    const pollKind = "@poll.Kind";

    // Multi-select: enforce the optional maximum.
    @if (poll is MultiSelectPoll ms && ms.MaxSelections.HasValue)
    {
        <text>
        const maxSelections = @ms.MaxSelections.Value;
        const checks = Array.from(document.querySelectorAll(".poll-check"));
        function enforceMax() {
            const picked = checks.filter(c => c.checked).length;
            checks.forEach(c => { c.disabled = !c.checked && picked >= maxSelections; });
        }
        checks.forEach(c => c.addEventListener("change", enforceMax));
        </text>
    }

    // Ranking: pointer-based reorder. The grabbed row lifts and follows the cursor
    // vertically (no native drag ghost) while the other rows reflow around it.
    if (pollKind === "Ranking") {
        const list = document.getElementById("rankList");
        const form = document.getElementById("answerForm");
        let dragEl = null;
        let grabOffset = 0;

        function renumber() {
            let i = 1;
            list.querySelectorAll(".rank-item").forEach(li => {
                li.querySelector(".rank-number").textContent = i++;
            });
        }

        list.addEventListener("pointerdown", e => {
            const handle = e.target.closest(".rank-handle");
            if (!handle) return;
            e.preventDefault();
            dragEl = handle.closest(".rank-item");
            dragEl.style.transition = "none"; // the grabbed row must track the cursor instantly
            grabOffset = e.clientY - dragEl.getBoundingClientRect().top;
            dragEl.classList.add("dragging");
            list.setPointerCapture(e.pointerId);
        });

        list.addEventListener("pointermove", e => {
            if (!dragEl) return;
            e.preventDefault();

            const cursorTop = e.clientY - grabOffset;
            const cursorMid = cursorTop + dragEl.offsetHeight / 2;

            // FLIP "first": remember where the other rows sit before any reorder.
            const others = [...list.querySelectorAll(".rank-item")].filter(it => it !== dragEl);
            const firsts = new Map(others.map(it => [it, it.getBoundingClientRect().top]));

            let moved = false;
            let prev;
            while ((prev = dragEl.previousElementSibling) &&
                   cursorMid < prev.getBoundingClientRect().top + prev.offsetHeight / 2) {
                list.insertBefore(dragEl, prev);
                moved = true;
            }
            let next;
            while ((next = dragEl.nextElementSibling) &&
                   cursorMid > next.getBoundingClientRect().top + next.offsetHeight / 2) {
                list.insertBefore(next, dragEl);
                moved = true;
            }

            // FLIP "invert + play": animate displaced rows from their old spot to the new one.
            if (moved) {
                others.forEach(it => {
                    it.style.transition = "none";
                    it.style.transform = "";
                    const delta = firsts.get(it) - it.getBoundingClientRect().top;
                    if (delta) it.style.transform = `translateY(${delta}px)`;
                });
                requestAnimationFrame(() => {
                    others.forEach(it => {
                        it.style.transition = "transform .3s ease";
                        it.style.transform = "";
                    });
                });
            }

            // Position the dragged row under the cursor relative to its current slot.
            dragEl.style.transform = "";
            const naturalTop = dragEl.getBoundingClientRect().top;
            dragEl.style.transform = `translateY(${cursorTop - naturalTop}px)`;

            renumber();
        });

        function endDrag(e) {
            if (!dragEl) return;
            const el = dragEl;
            dragEl = null;
            try { list.releasePointerCapture(e.pointerId); } catch (_) { }

            // Ease the dropped row into its slot, then drop the lifted styling.
            if (el.style.transform && el.style.transform !== "none") {
                el.style.transition = "transform .3s ease";
                el.style.transform = "";
                el.addEventListener("transitionend", function done() {
                    el.classList.remove("dragging");
                    el.style.transition = "";
                    el.removeEventListener("transitionend", done);
                });
            } else {
                el.classList.remove("dragging");
                el.style.transition = "";
            }
        }
        list.addEventListener("pointerup", endDrag);
        list.addEventListener("pointercancel", endDrag);

        form.addEventListener("submit", () => {
            list.querySelectorAll(".rank-item").forEach(li => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "optionIds";
                input.value = li.dataset.id;
                form.appendChild(input);
            });
        });
    }
</script>
