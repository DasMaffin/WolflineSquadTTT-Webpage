@{
    ViewData["Title"] = "Datenschutzerklärung";
}
@section Styles {
    <style>
        @*Display all tabs at once when a print is initiated.*@
        @@media print {

            .nav,
            .nav-tabs,
            .nav-pills {
                display: none !important;
            }

            .tab-content > .tab-pane {
                display: block !important;
                opacity: 1 !important;
                visibility: visible !important;
            }

            .tab-pane {
                transform: none !important;
            }

            .container-background,
            .card,
            .tab-content {
                border: none !important;
                box-shadow: none !important;
            }

            body {
                background: white !important;
                color: black !important;
            }
        }
    </style>
}


<div class="container container-background mt-4">

    <h1>Datenschutzerklärung (DSGVO)</h1>
    <p class="text-muted">Stand: Juni 2026</p>
    <p><strong>TTT Server „TTT WolflineSquad“</strong></p>

    <hr />

    <section>
        <h2>Verantwortlicher</h2>
        <p>
            Maffin e.U.<br />
            Kontakt: <a href="mailto:admin@dasmaffin.com">admin@dasmaffin.com</a>
        </p>
    </section>

    <section>
        <h2>1. Erhebung und Speicherung personenbezogener Daten</h2>
        <p>
            Auf unserem TTT-Server werden personenbezogene Daten ausschließlich zu Zwecken des Serverbetriebs,
            der Spielerverwaltung und der Verbesserung des Spielerlebnisses erhoben, verarbeitet und gespeichert.
        </p>
        
        <!-- Tab headers -->
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link text-body active"
                        id="Pointshop2-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#Pointshop2"
                        type="button"
                        role="tab">
                    Pointshop 2
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="ActivityTracker-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#ActivityTracker"
                        type="button"
                        role="tab">
                    Activity Tracker
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="Damagelog-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#Damagelog"
                        type="button"
                        role="tab">
                    Damagelog
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="GoldenDeagle-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#GoldenDeagle"
                        type="button"
                        role="tab">
                    Golden Deagle
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="Benutzerverwaltung-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#Benutzerverwaltung"
                        type="button"
                        role="tab">
                    Benutzerverwaltung
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="Umfragen-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#Umfragen"
                        type="button"
                        role="tab">
                    Umfragen
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link text-body"
                        id="Belohnungen-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#Belohnungen"
                        type="button"
                        role="tab">
                    Belohnungen
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content border border-top-0 p-3" id="myTabContent">

            <div class="tab-pane fade show active"
                 id="Pointshop2"
                 role="tabpanel">
                <h3>Pointshop 2</h3>
                <ul>
                    <li>Gespeichert werden gekaufte Items und Punkte auf unserer Server-Datenbank</li>
                    <li>Keine Weitergabe an Dritte</li>
                </ul>
            </div>

            <div class="tab-pane fade"
                 id="ActivityTracker"
                 role="tabpanel">
                <h3>Activity Tracker Plugin</h3>
                <ul>
                    <li>Speicherung als JSON-Datei im DATA-Ordner</li>
                    <li>
                        Erhobene Daten:
                        <ul>
                            <li>Start- und Endzeit der Runde</li>
                            <li>Anzahl der Spieler pro Runde</li>
                            <li>Aktivität (aktiv / AFK)</li>
                            <li>Anzahl abgeschlossener Damagelog-Reports</li>
                        </ul>
                    </li>
                    <li>Identifikation über SteamID64 (eindeutige Online-Kennung im Sinne von Art. 4 Nr. 1 DSGVO)</li>
                    <li>Keine Weitergabe an Dritte</li>
                </ul>
            </div>

            <div class="tab-pane fade"
                 id="Damagelog"
                 role="tabpanel">
                <h3>Damagelog-Addon</h3>
                <ul>
                    <li>Speicherung nur für die Dauer von zwei Maps</li>
                    <li>Keine Verbindung zu anderen Datenbanken</li>
                    <li>Keine zusätzlichen personenbezogenen Daten</li>
                    <li>Keine Weitergabe an Dritte</li>
                </ul>
            </div>

            <div class="tab-pane fade"
                 id="GoldenDeagle"
                 role="tabpanel">
                <h3>GoldenDeagle-Addon</h3>
                <ul>
                    <li>Die Daten liegen am Server von <a href="https://www.smarterasp.net/privacy" target="_blank">SmarterASP</a></li>
                    <li>
                        Erhobene Daten:
                        <ul>
                            <li>Genaue Zeit des Schusses</li>
                            <li>SteamID des Schützen</li>
                            <li>SteamID des angeschossenen</li>
                            <li>Rolle des angeschossenen</li>
                        </ul>
                    </li>
                    <li>Diese Daten werden aufgenommen um Ghostingfällen nachzugehen, und das direkte mobben von Spielern zu verhindern.</li>
                    <li>Keine Weitergabe an Dritte</li>
                </ul>
            </div>

            <div class="tab-pane fade"
                 id="Benutzerverwaltung"
                 role="tabpanel">
                <h3>Website: Benutzerverwaltung</h3>
                <ul>
                    <li>Eindeutige interne Benutzer-ID</li>
                    <li>Steam-ID zur Identifikation angemeldeter Nutzer</li>
                    <li>Zugewiesene Benutzerrechte (z. B. Administrator- oder Moderationsrechte)</li>
                </ul>
                <p>
                    Diese Daten sind erforderlich, um Benutzerkonten zu verwalten, Berechtigungen zu steuern
                    und den sicheren Betrieb der Website zu gewährleisten.
                </p>
            </div>

            <div class="tab-pane fade"
                 id="Umfragen"
                 role="tabpanel">
                <h3>Website: Umfragen (Polls)</h3>
                <ul>
                    <li>Die von dir gewählte(n) Antwort(en) einer Umfrage</li>
                    <li>Bei Ranking-Umfragen zusätzlich die von dir vergebene Platzierung der Antworten</li>
                    <li>Zeitpunkt der Teilnahme</li>
                    <li>Verknüpfung mit deinem Benutzerkonto (interne Benutzer-ID bzw. SteamID)</li>
                </ul>
                <p>
                    Umfragen werden vom Betreiberteam der Website erstellt und verwaltet.
                    Es handelt sich nicht um nutzergenerierte Inhalte. Eine Teilnahme ist nur
                    angemeldeten Nutzern möglich.
                </p>
            </div>

            <div class="tab-pane fade"
                 id="Belohnungen"
                 role="tabpanel">
                <h3>Website: Belohnungen (Rewards)</h3>
                <ul>
                    <li>
                        Für die Teilnahme an einer Umfrage kann eine Belohnung in Form von
                        In-Game-Währung (Garry's Mod: normale Punkte und Premium-Punkte) gewährt werden.
                    </li>
                    <li>
                        Gespeichert wird, dass deinem Konto (interne Benutzer-ID bzw. SteamID) für eine
                        bestimmte Umfrage eine Belohnung zusteht, sowie ob diese bereits ausgezahlt wurde.
                    </li>
                    <li>
                        Der Garry's-Mod-Server fragt offene Belohnungen anhand der SteamID ab und zahlt sie
                        im Spiel aus. Das Markieren als „ausgezahlt“ ist durch einen geheimen API-Schlüssel
                        geschützt, sodass dies nur durch den Spielserver erfolgen kann.
                    </li>
                    <li>Keine Weitergabe an Dritte</li>
                </ul>
            </div>
        </div>
    </section>
    <br />
    <section>
        <h2>2. Zweck der Verarbeitung</h2>
        <ul>
            <li>Verbesserung des Spielerlebnisses</li>
            <li>Spielerverwaltung</li>
            <li>Statistik- und Aktivitätsauswertung</li>
            <li>Keine öffentlichen Spielerprofile</li>
        </ul>
    </section>

    <section>
        <h2>3. Rechtsgrundlage</h2>
        <p>
            Die Verarbeitung erfolgt gemäß Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse),
            da sie für den Betrieb des Servers erforderlich ist.
        </p>
    </section>

    <section>
        <h2>4. Speicherdauer</h2>
        <ul>
            <li>Pointshop-Daten: Solange der Spieler registriert ist</li>
            <li>Activity-Tracker-Daten: Solange sie für Auswertungen benötigt werden</li>
            <li>Damagelog-Daten: Nur temporär</li>
        </ul>
    </section>

    <section>
        <h2>5. Rechte der betroffenen Personen</h2>
        <ul>
            <li>Auskunft über gespeicherte Daten</li>
            <li>Berichtigung falscher Daten</li>
            <li>Löschung der Daten (sofern zulässig)</li>
            <li>Einschränkung der Verarbeitung</li>
        </ul>

        <p>
            Kontakt zur Rechteausübung:
            <a href="mailto:admin@dasmaffin.com">admin@dasmaffin.com</a>
        </p>
    </section>

    <section>
        <h2>6. Weitergabe an Dritte</h2>
        <ul>
            <li>Keine Weitergabe personenbezogener Daten</li>
            <li>Alle Daten verbleiben auf dem Server</li>
        </ul>
    </section>

    <section>
        <h2>7. Cookies</h2>
        <p>
            Diese Website verwendet ausschließlich technisch notwendige Cookies. Es werden keine
            Tracking-, Analyse- oder Werbe-Cookies und keine Cookies von Dritten eingesetzt.
        </p>
        <ul>
            <li>
                <strong>Sitzungs-Cookie</strong> (<code>.AspNetCore.Session</code>): Hält deine Sitzung
                während des Besuchs aufrecht. Es wird beim Schließen des Browsers bzw. nach Ablauf der
                Sitzung gelöscht.
            </li>
            <li>
                <strong>Login-Cookie</strong> (<code>WolflineLogin</code>): Wird nur gesetzt, wenn du
                dich aktiv über Steam anmeldest, und sorgt dafür, dass du angemeldet bleibst, ohne dich
                bei jedem Besuch erneut anmelden zu müssen. Gespeichert wird ausschließlich deine SteamID
                in signierter (manipulationssicherer) Form; das Cookie ist 30 Tage gültig.
            </li>
        </ul>
        <p>
            Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse) bzw. § 165 Abs. 3
            TKG 2021, da die Cookies für die von dir angeforderte Funktion (Anmeldung) erforderlich sind.
        </p>
        <p>
            Du kannst das Login-Cookie jederzeit entfernen, indem du dich abmeldest oder die Cookies in
            deinem Browser löschst.
        </p>
    </section>

    <section>
        <h2>8. Änderungen der Datenschutzerklärung</h2>
        <p>
            Änderungen werden auf dem Server oder über unsere Kommunikationskanäle bekannt gegeben.
        </p>
    </section>
</div>