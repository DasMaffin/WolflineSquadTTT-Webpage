@model RewardManagementViewModel
@{
    ViewData["Title"] = "Manage Rewards";
}

<div class="poll-panel my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Manage Rewards</h1>
        <a class="btn btn-secondary" asp-controller="Polls" asp-action="PollManagement">Back to polls</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Create reward</h5>
            <form asp-action="CreateReward" method="post" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input name="Name" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Type</label>
                    <select name="RewardType" class="form-select" asp-items="Html.GetEnumSelectList<RewardType>()"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Normal points</label>
                    <input name="NormalPoints" type="number" class="form-control" value="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Premium points</label>
                    <input name="PremiumPoints" type="number" class="form-control" value="0" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>

    <h3>Existing rewards</h3>
    @if (!Model.Rewards.Any())
    {
        <p class="text-muted">No rewards yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Normal points</th>
                    <th>Premium points</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Reward reward in Model.Rewards)
                {
                    <tr>
                        <td>@reward.Name</td>
                        <td>@reward.RewardType</td>
                        <td>@reward.NormalPoints</td>
                        <td>@reward.PremiumPoints</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
