@model PointShopInventoryViewModel
@{
    ViewData["Title"] = "Pointshop Inventory";

    string heading = Model.IsSelf
        ? "My Inventory"
        : (Model.Found ? $"{Model.PlayerName}'s Inventory" : "Player Inventory");

    string[] typeOrder = { "weapon", "singleuse", "model", "container", "trail", "hat", "key", "crate", "role", "currency", "other" };
    Dictionary<string, string> typeLabels = new()
    {
        ["weapon"] = "Weapons",
        ["singleuse"] = "Single-use weapons",
        ["model"] = "Player models",
        ["container"] = "Model containers",
        ["trail"] = "Trails",
        ["hat"] = "Hats & accessories",
        ["key"] = "Keys",
        ["crate"] = "Crates",
        ["role"] = "Role control",
        ["currency"] = "Currency",
        ["other"] = "Other"
    };
    List<string> presentTypes = Model.Items.Select(i => i.TypeKey)
        .Concat(Model.Equipment.Where(e => e.Item != null).Select(e => e.Item!.TypeKey))
        .Distinct()
        .OrderBy(k => Array.IndexOf(typeOrder, k))
        .ToList();
}

<div class="poll-panel my-4 ps-inventory">
    <div class="ps-topbar">
        <div class="ps-title">Pointshop <span class="ps-title-2">2</span> <span class="ps-sub">@heading</span></div>
        @if (Model.Found)
        {
            <div class="ps-currencies">
                <span class="ps-cur points">@Model.Points.ToString("N0") Points</span>
                <span class="ps-cur premium">@Model.PremiumPoints.ToString("N0") Premium</span>
                <span class="ps-cur eggs">@Model.EasterEggs.ToString("N0") Easter Eggs</span>
            </div>
        }
    </div>

    @if (!Model.Found)
    {
        <p class="text-muted">
            @if (Model.IsSelf)
            {
                @:We couldn't find any Pointshop data for your account yet. Join the server at least once and your inventory will appear here.
            }
            else
            {
                @:We couldn't find any Pointshop data for this player. They may not have joined the server yet.
            }
        </p>
    }
    else
    {
        int totalCells = Math.Max(Model.NumSlots, Model.Items.Count);

        @if (Model.IsSelf)
        {
            @Html.AntiForgeryToken()
        }

        <div class="ps-layout">
            <div class="ps-grid-wrap">
                <div class="ps-grid-head">
                    <span>Items</span>
                    <span class="text-muted">@Model.FilledSlots / @Model.NumSlots slots</span>
                </div>
                <div class="ps-grid">
                    @for (int i = 0; i < totalCells; i++)
                    {
                        if (i < Model.Items.Count)
                        {
                            PointShopItem item = Model.Items[i];
                            <div class="ps-slot filled ps-type-@item.TypeKey"
                                 data-kinv-id="@item.KinvItemId" data-item-name="@item.Name"
                                 title="@item.Name@(item.Category != null ? " — " + item.Category : "")">
                                <span class="ps-name">@item.Name</span>
                                @if (item.Quantity > 1)
                                {
                                    <span class="ps-qty">@item.Quantity</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="ps-slot empty"></div>
                        }
                    }
                </div>
            </div>

            <div class="ps-equip">
                <div class="ps-grid-head"><span>Equipped</span></div>
                @if (!Model.Equipment.Any())
                {
                    <p class="text-muted small">Nothing equipped.</p>
                }
                else
                {
                    <div class="ps-equip-grid">
                        @foreach (PointShopEquipSlot slot in Model.Equipment)
                        {
                            <div class="ps-equip-slot">
                                @if (slot.IsEmpty)
                                {
                                    <div class="ps-slot empty"></div>
                                }
                                else
                                {
                                    <div class="ps-slot filled ps-type-@slot.Item!.TypeKey@(Model.IsSelf ? " ps-unequip" : "")"
                                         data-slot-id="@slot.EquipSlotId"
                                         title="@slot.Item.Name@(slot.Item.Category != null ? " — " + slot.Item.Category : "")@(Model.IsSelf ? " (double-click to unequip)" : "")">
                                        <span class="ps-name">@slot.Item.Name</span>
                                    </div>
                                }
                                <span class="ps-equip-label">@slot.SlotName</span>
                            </div>
                        }
                    </div>
                }

                @if (presentTypes.Any())
                {
                    <div class="ps-legend mt-4">
                        <div class="ps-grid-head"><span>Legend</span></div>
                        @foreach (string key in presentTypes)
                        {
                            <div class="ps-legend-row">
                                <span class="ps-legend-swatch ps-type-@key"></span>
                                <span class="ps-legend-label">@typeLabels[key]</span>
                            </div>
                        }
                        <div class="ps-legend-hint">Right-click any item for more options</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div id="ps-context-menu" class="ps-context-menu" role="menu">
    <button type="button" class="ps-context-item" data-action="sell" style="display:none;">Sell on market</button>
    <button type="button" class="ps-context-item" data-action="default">Show default options</button>
</div>

@if (Model.IsSelf)
{
    <div class="modal fade" id="ps-sell-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header">
                    <h5 class="modal-title">Sell on market</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Listing: <strong id="ps-sell-itemname"></strong></p>
                    <input type="hidden" id="ps-sell-kinvid" />
                    <div class="mb-3">
                        <label class="form-label d-block">Listing type</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="ps-sell-type" id="ps-sell-fixed" value="FixedPrice" checked>
                            <label class="form-check-label" for="ps-sell-fixed">Fixed price</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="ps-sell-type" id="ps-sell-auction" value="Auction">
                            <label class="form-check-label" for="ps-sell-auction">Auction</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" id="ps-sell-price-label" for="ps-sell-price">Price (points)</label>
                        <input type="number" min="1" class="form-control" id="ps-sell-price" />
                    </div>
                    <div class="mb-3" id="ps-sell-duration-wrap" style="display:none;">
                        <label class="form-label" for="ps-sell-duration">Auction duration</label>
                        <select class="form-select" id="ps-sell-duration">
                            <option value="6">6 hours</option>
                            <option value="12">12 hours</option>
                            <option value="24" selected>24 hours</option>
                            <option value="48">2 days</option>
                            <option value="72">3 days</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="ps-sell-submit">List item</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.IsSelf && Model.Found)
    {
        <script>
            document.querySelectorAll('.ps-equip-slot .ps-slot.ps-unequip[data-slot-id]').forEach(function (el) {
                el.addEventListener('dblclick', async function () {
                    var slotId = el.getAttribute('data-slot-id');
                    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (!tokenInput) return;

                    el.style.opacity = '0.5';
                    try {
                        var resp = await fetch('/pointshop2/unequip', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ slotId: slotId, __RequestVerificationToken: tokenInput.value })
                        });
                        if (resp.ok) {
                            location.reload();
                        } else {
                            el.style.opacity = '1';
                            var msg = await resp.text();
                            alert(msg || 'Could not unequip that item.');
                        }
                    } catch (e) {
                        el.style.opacity = '1';
                        alert('Could not unequip that item. Please try again.');
                    }
                });
            });
        </script>
    }

    <script>
        (function () {
            var menu = document.getElementById('ps-context-menu');
            var scope = document.querySelector('.ps-inventory');
            if (!menu || !scope) return;

            var psIsSelf = @(Model.IsSelf ? "true" : "false");
            var sellItem = menu.querySelector('[data-action="sell"]');
            var bypassNext = false;
            var ctxTile = null;

            scope.addEventListener('contextmenu', function (e) {
                // One real right-click after "Show default options" is allowed through to the browser's menu —
                // browsers don't permit opening the native context menu programmatically.
                if (bypassNext) { bypassNext = false; return; }
                e.preventDefault();

                ctxTile = psIsSelf ? e.target.closest('.ps-grid .ps-slot.filled') : null;
                var kinvId = ctxTile ? parseInt(ctxTile.getAttribute('data-kinv-id') || '0', 10) : 0;
                if (sellItem) sellItem.style.display = kinvId > 0 ? 'block' : 'none';

                menu.classList.add('show');
                var x = Math.min(e.clientX, window.innerWidth - menu.offsetWidth - 6);
                var y = Math.min(e.clientY, window.innerHeight - menu.offsetHeight - 6);
                menu.style.left = Math.max(0, x) + 'px';
                menu.style.top = Math.max(0, y) + 'px';
            });

            function hide() { menu.classList.remove('show'); }
            document.addEventListener('click', hide);
            document.addEventListener('scroll', hide, true);
            window.addEventListener('resize', hide);
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });

            menu.querySelector('[data-action="default"]').addEventListener('click', function (e) {
                e.stopPropagation();
                hide();
                bypassNext = true;
            });

            if (sellItem) {
                sellItem.addEventListener('click', function (e) {
                    e.stopPropagation();
                    hide();
                    if (!ctxTile) return;
                    var kinvId = parseInt(ctxTile.getAttribute('data-kinv-id') || '0', 10);
                    var name = ctxTile.getAttribute('data-item-name') || 'item';
                    if (kinvId > 0 && window.psOpenSellModal) window.psOpenSellModal(kinvId, name);
                });
            }
        })();
    </script>

    @if (Model.IsSelf)
    {
        <script>
            var psSocketConnected = @(Model.SocketConnected ? "true" : "false");

            window.psOpenSellModal = function (kinvId, name) {
                if (!psSocketConnected) {
                    alert("Server connection could not be established. Make sure the Garry's Mod server is running and connected to change items. Inform the administrator about this.");
                    return;
                }
                document.getElementById('ps-sell-kinvid').value = kinvId;
                document.getElementById('ps-sell-itemname').textContent = name;
                document.getElementById('ps-sell-price').value = '';
                document.getElementById('ps-sell-fixed').checked = true;
                document.getElementById('ps-sell-duration-wrap').style.display = 'none';
                document.getElementById('ps-sell-price-label').textContent = 'Price (points)';
                new bootstrap.Modal(document.getElementById('ps-sell-modal')).show();
            };

            document.querySelectorAll('input[name="ps-sell-type"]').forEach(function (r) {
                r.addEventListener('change', function () {
                    var auction = document.getElementById('ps-sell-auction').checked;
                    document.getElementById('ps-sell-duration-wrap').style.display = auction ? 'block' : 'none';
                    document.getElementById('ps-sell-price-label').textContent = auction ? 'Starting price (points)' : 'Price (points)';
                });
            });

            document.getElementById('ps-sell-submit').addEventListener('click', async function () {
                var kinvId = document.getElementById('ps-sell-kinvid').value;
                var price = document.getElementById('ps-sell-price').value;
                var auction = document.getElementById('ps-sell-auction').checked;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                if (!price || parseInt(price, 10) <= 0) { alert('Enter a price greater than 0.'); return; }

                var body = new URLSearchParams({
                    kinvItemId: kinvId,
                    type: auction ? 'Auction' : 'FixedPrice',
                    price: price,
                    __RequestVerificationToken: token
                });
                if (auction) body.append('durationHours', document.getElementById('ps-sell-duration').value);

                try {
                    var resp = await fetch('/pointshop2/market/list', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body
                    });
                    if (resp.ok) { location.reload(); }
                    else { alert(await resp.text() || 'Could not list that item.'); }
                } catch (e) { alert('Could not list that item. Please try again.'); }
            });
        </script>
    }
}
